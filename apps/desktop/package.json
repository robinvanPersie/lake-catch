{
  "name": "@lake/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cd ../.. && node scripts/prepare-mcp-bundle.mjs && pnpm --filter @lake/desktop exec tsc -b && pnpm --filter @lake/desktop exec vite build",

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for Lake Catch desktop windows",
  "windows": ["main", "lanhu-browser"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window"
  ],
  "remote": {
    "urls": [
      "https://lanhuapp.com/**",
      "https://*.lanhuapp.com/**"
    ]
  }
}

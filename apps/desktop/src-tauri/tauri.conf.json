{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lake Catch",
  "version": "../../../package.json",
  "identifier": "com.lake.catch",
  "build": {
    "beforeDevCommand": "PNPM_BIN=$(find \"$HOME/Library/pnpm/package-manager-store\" -path '*/@pnpm/exe/9.15.0/*/bin/pnpm' -type f | head -1); \"$PNPM_BIN\" --filter @lake/desktop dev",
    "beforeBuildCommand": "pnpm --filter @lake/desktop build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Lake Catch", "width": 1440, "height": 900, "resizable": true }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://lanhuapp.com https://*.lanhuapp.com; img-src 'self' asset: data: https://lanhuapp.com https://*.lanhuapp.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": { "resources/mcp-server": "mcp-server" },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
